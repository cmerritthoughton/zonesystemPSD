{
  "manifestVersion": 5,
  "id": "com.cmerritthoughton.visualize-first",
  "name": "Visualize First",
  "version": "1.1.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "visualizeFirstPanel",
      "label": { "default": "Visualize First" },
      "minimumSize": { "width": 260, "height": 360 },
      "maximumSize": { "width": 1200, "height": 4000 },
      "preferredDockedSize": { "width": 320, "height": 720 },
      "preferredFloatingSize": { "width": 340, "height": 760 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
